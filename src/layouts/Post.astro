---
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';
import Base from './Base.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import GenHero from '../components/GenHero.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  kind: string;
  affiliate?: boolean;
  /** 文首题图（本地 assets/posts，ImageMetadata 由 z.image() 解析） */
  hero?: ImageMetadata;
  heroAlt?: string;
  /** 同 cluster 的其他文章，用于内链 —— 这是 cluster 密度的关键 */
  siblings?: { href: string; title: string }[];
}
const {
  title, description, pubDate, updatedDate, kind,
  affiliate = false, hero, heroAlt, siblings = [],
} = Astro.props;

const KIND_LABEL: Record<string, string> = {
  comparison: 'Comparison',
  'hands-on': 'Hands-on',
  guide: 'Guide',
  hardware: 'Hardware',
};

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(d);

// BlogPosting everywhere. Do NOT emit schema.org Review here: a Review
// requires itemReviewed (+ a rating) pointing at ONE thing, our comparison
// posts cover several tools, and GSC flags a bare Review as a critical
// structured-data error (2026-10-13 incident). Revisit only if a future
// post reviews a single product with a real rating.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={title} description={description} ogType="article">
  <article class:list={['post', `k-${kind}`]}>
    <h1>{title}</h1>
    <p class="meta">
      <span class:list={['kind', `kind-${kind}`]}>{KIND_LABEL[kind] ?? kind}</span>
      <span>{fmt(pubDate)}{updatedDate && <> · updated {fmt(updatedDate)}</>}</span>
    </p>

    {hero ? (
      <figure class="post-hero">
        <img
          src={hero.src}
          alt={heroAlt ?? ''}
          width={hero.width ?? 680}
          height={hero.height ?? 310}
          loading="eager"
          decoding="async"
        />
      </figure>
    ) : (
      // 没有手绘 hero 的文章：程序化 title-card 兜底，保证全站"图文各半"的密度
      <figure class="post-hero">
        <GenHero kind={kind} title={title} />
      </figure>
    )}

    {affiliate && <AffiliateNotice />}

    <slot />

    {siblings.length > 0 && (
      <nav class="cluster-rail">
        <h4>More in this series</h4>
        <ul>
          {siblings.map((s) => (
            <li><a href={s.href}>{s.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>
