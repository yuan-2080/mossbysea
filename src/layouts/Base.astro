---
import { SITE, ANALYTICS } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传 article，其余留空 */
  ogType?: 'website' | 'article';
  /** true 时输出 noindex —— 空栏目页、内页不要进索引 */
  noindex?: boolean;
}
const {
  title,
  description = SITE.description,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL('logo-512.png', Astro.site).href} />
    <meta name="twitter:image" content={new URL('logo-512.png', Astro.site).href} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- PartnerBoost site ownership verification -->
    <meta name="partnerboostverifycode" content="32dc01246faccb7f5b3cad5016dd5033" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    {/* 统计：token 为空则整段不输出。见 consts.ts 的 ANALYTICS 注释。 */}
    {
      ANALYTICS.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token":"${ANALYTICS.cfBeaconToken}"}`}
        />
      )
    }
  </head>
  <body>
    <div class="shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
