---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';

// frontmatter 里 hero 存的是相对 content 文件的路径（与正文图片同语法），
// 这里按文件名解析成 ImageMetadata —— zod v4 没有 z.image()，手动桥接。
// 必须 eager：默认的懒加载 glob 返回的是函数不是模块
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/posts/*.{svg,png,jpg,jpeg,webp,avif}',
  { eager: true },
);
function resolveHero(path?: string): ImageMetadata | undefined {
  if (!path) return undefined;
  const key = `../../assets/posts/${path.split('/').pop()}`;
  return heroImages[key]?.default;
}

export async function getStaticPaths() {
  const posts = await getCollection('setup', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // 同 cluster 的其他文章 —— 内链密度靠这个自动维持
      siblings: posts
        .filter((p) => p.id !== post.id)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, 5)
        .map((p) => ({ href: `/setup/${p.id}/`, title: p.data.title })),
    },
  }));
}

const { post, siblings } = Astro.props;
const { Content } = await render(post);
---
<Post {...post.data} hero={resolveHero(post.data.hero)} siblings={siblings}>
  <Content />
</Post>
