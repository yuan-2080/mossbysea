---
// ─────────────────────────────────────────────────────────────
// 外接屏清晰度计算器。算法在 src/lib/display.ts，构建期和浏览器端共用。
//
// 设计约束：
//   · 本页不挂联盟链接 —— 它是被 Reddit 回帖 / 他站引用的「可链资产」，
//     干净的工具页更容易被链；商品推荐导到显示器 money page。
//   · 无 JS 时也有完整内容：下方常见显示器表是构建期算好的静态 HTML。
//   · 输入写回 URL（?d=27&w=3840&h=2160），回帖时可以直接贴结果链接。
// ─────────────────────────────────────────────────────────────
import Base from '../../layouts/Base.astro';
import { analyse, PRESETS, VERDICT_TEXT } from '../../lib/display';

const rows = PRESETS.map((p) => ({ ...p, r: analyse(p.d, p.w, p.h)! }));
const fmt = (n: number) => n.toLocaleString('en-US');
---
<Base
  title="Mac monitor ppi and scaling calculator"
  description="Enter a monitor's size and resolution to see its ppi and how macOS will scale it: clean Retina 2×, native 1×, or the fractional zone where text goes soft."
>
  <article class="calc-page">
    <h1>Mac monitor ppi and scaling calculator</h1>
    <p class="lede">
      Will this monitor look sharp on a Mac? Size and resolution are enough to tell you.
      The calculator works out pixel density and which of macOS's scaling modes the panel
      will end up in.
    </p>

    <form class="calc" id="calc" onsubmit="return false" aria-describedby="calc-help">
      <div class="calc-row">
        <label class="calc-field calc-preset">
          <span>Common monitor</span>
          <select id="preset">
            <option value="">Custom…</option>
            {PRESETS.map((p, i) => <option value={i} selected={i === 3}>{p.name}</option>)}
          </select>
        </label>
      </div>
      <div class="calc-row">
        <label class="calc-field">
          <span>Diagonal (inches)</span>
          <input id="d" type="number" inputmode="decimal" min="5" max="120" step="0.1" value="27" required />
        </label>
        <label class="calc-field">
          <span>Width (px)</span>
          <input id="w" type="number" inputmode="numeric" min="320" max="16384" step="1" value="3840" required />
        </label>
        <label class="calc-field">
          <span>Height (px)</span>
          <input id="h" type="number" inputmode="numeric" min="240" max="16384" step="1" value="2160" required />
        </label>
      </div>
      <p class="meta" id="calc-help">Use the panel's native resolution from the spec sheet, not a scaled one.</p>
    </form>

    <section class="calc-out" id="out" aria-live="polite">
      <div class="calc-stat">
        <span class="calc-num" id="o-ppi">163</span>
        <span class="calc-unit">ppi</span>
      </div>
      <div class="calc-verdict" id="o-verdict" data-tone="warn">
        <strong id="o-label">{VERDICT_TEXT.fractional.label}</strong>
        <p id="o-body">{VERDICT_TEXT.fractional.body}</p>
      </div>

      <div class="ladder" aria-hidden="true">
        <div class="ladder-track">
          <span class="ladder-zone z-low" style="left:0;width:22.5%"></span>
          <span class="ladder-zone z-ok" style="left:22.5%;width:8.75%"></span>
          <span class="ladder-zone z-frac" style="left:31.25%;width:13.75%"></span>
          <span class="ladder-zone z-good" style="left:45%;width:17.5%"></span>
          <span class="ladder-zone z-dense" style="left:62.5%;width:37.5%"></span>
          <span class="ladder-mark" id="o-mark" style="left:40.75%"></span>
        </div>
        <div class="ladder-ticks">
          <span style="left:22.5%">90</span>
          <span style="left:31.25%">125</span>
          <span style="left:45%">180</span>
          <span class="tick-218" style="left:54.5%">218</span>
          <span style="left:62.5%">250</span>
        </div>
      </div>

      <dl class="calc-facts">
        <div><dt>Looks like (recommended)</dt><dd id="o-looks">2560 × 1440</dd></div>
        <div><dt>macOS renders at</dt><dd id="o-render">5120 × 2880</dd></div>
        <div><dt>Resampling to panel</dt><dd id="o-resample">× 0.75 (non-integer)</dd></div>
        <div><dt>Physical size</dt><dd id="o-size">23.5 × 13.2 in</dd></div>
        <div><dt>Pixels stop being visible beyond</dt><dd id="o-dist">21 in / 54 cm</dd></div>
      </dl>
      <p class="meta calc-share">
        <a id="o-link" href="?d=27&w=3840&h=2160">Link to this result</a>
      </p>
    </section>

    <h2>Common monitors at a glance</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Monitor</th><th>ppi</th><th>On a Mac</th><th>Looks like</th></tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td><a href={`?d=${p.d}&w=${p.w}&h=${p.h}`}>{p.name}</a></td>
              <td>{Math.round(p.r.ppi)}</td>
              <td>{VERDICT_TEXT[p.r.verdict].label.split(' — ')[0]}</td>
              <td>{fmt(p.r.looksLike[0])} × {fmt(p.r.looksLike[1])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="calc-note">
      For reference, Apple's own displays — Studio Display, 24-inch iMac, Pro Display XDR —
      all sit at 218 ppi, and the 13-inch MacBook Air M4 at 224 ppi.
    </p>

    <h2>How the numbers are worked out</h2>
    <p>
      <strong>Pixel density</strong> is the diagonal in pixels, √(width² + height²), divided by
      the diagonal in inches. That part is exact.
    </p>
    <p>
      <strong>The verdict</strong> rests on how macOS draws its interface. It is designed for
      roughly 110 logical pixels per inch at desk distance, and Retina screens draw each
      logical pixel as a 2 × 2 block — which is why Apple's desktop displays are all about
      218 ppi. The calculator checks two clean options first:
    </p>
    <ul>
      <li><strong>2×</strong> works when half the panel's ppi lands between about 90 and 125 — the interface is a sensible size and nothing is resampled.</li>
      <li><strong>1×</strong> works when the panel's own ppi lands in that range — sensible size, no scaling, but standard-density text.</li>
    </ul>
    <p>
      If neither fits, a comfortable size needs a non-integer mode. macOS renders the desktop at
      twice the "looks like" resolution and then scales that frame down to the panel. The
      resampling factor above is that squeeze; anything other than 1 means fine detail is being
      interpolated.
    </p>
    <p>
      The 90–125 band is a rule of thumb from how macOS behaves, not a figure Apple publishes,
      and comfort depends on your eyes and how far you sit. The "looks like" suggestion is
      rounded to a width close to the options macOS's Display settings usually offer; your
      exact list depends on the monitor and the Mac. The viewing-distance figure assumes
      one arcminute of visual acuity (20/20 vision).
    </p>

    <h2>What to do with the result</h2>
    <p>
      If the verdict is fractional, the monitor still works — it just is not the sharpest way to
      spend the money on a Mac. The reasoning, the trade-offs between 24-inch 4K, 27-inch 5K and
      32-inch 6K, and specific models are in
      <a href="/setup/external-monitor-for-macbook-air/">External monitor for a MacBook Air: ppi, not size</a>.
      If you are planning more than one screen, check
      <a href="/setup/macbook-air-m4-dual-display/">how many external displays a MacBook Air M4 drives</a>
      first.
    </p>
  </article>

  <script>
    import { analyse, PRESETS, VERDICT_TEXT } from '../../lib/display';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const preset = $<HTMLSelectElement>('preset');
    const dIn = $<HTMLInputElement>('d');
    const wIn = $<HTMLInputElement>('w');
    const hIn = $<HTMLInputElement>('h');
    const fmt = (n: number) => n.toLocaleString('en-US');
    // 刻度：0–400 ppi 线性映射到轨道
    const pos = (ppi: number) => Math.min(100, Math.max(0, (ppi / 400) * 100));

    function syncPreset() {
      const d = +dIn.value, w = +wIn.value, h = +hIn.value;
      const i = PRESETS.findIndex((p) => p.d === d && p.w === w && p.h === h);
      preset.value = i >= 0 ? String(i) : '';
    }

    function render(writeUrl = true) {
      const d = +dIn.value, w = +wIn.value, h = +hIn.value;
      const r = analyse(d, w, h);
      const out = $('out');
      if (!r) { out.hidden = true; return; }
      out.hidden = false;
      const v = VERDICT_TEXT[r.verdict];
      $('o-ppi').textContent = String(Math.round(r.ppi));
      $('o-verdict').dataset.tone = v.tone;
      $('o-label').textContent = v.label;
      $('o-body').textContent = v.body;
      $('o-mark').style.left = pos(r.ppi) + '%';
      $('o-looks').textContent = `${fmt(r.looksLike[0])} × ${fmt(r.looksLike[1])}`;
      $('o-render').textContent = `${fmt(r.renderAt[0])} × ${fmt(r.renderAt[1])}`;
      $('o-resample').textContent =
        r.resample === 1 ? 'None (1 : 1)' : `× ${r.resample.toFixed(2)} (non-integer)`;
      $('o-size').textContent =
        `${r.widthIn.toFixed(1)} × ${r.heightIn.toFixed(1)} in (${(r.widthIn * 2.54).toFixed(0)} × ${(r.heightIn * 2.54).toFixed(0)} cm)`;
      $('o-dist').textContent =
        `${Math.round(r.pixelFreeDistanceIn)} in / ${Math.round(r.pixelFreeDistanceIn * 2.54)} cm`;
      const qs = `?d=${d}&w=${w}&h=${h}`;
      $<HTMLAnchorElement>('o-link').href = qs;
      if (writeUrl) history.replaceState(null, '', qs);
    }

    preset.addEventListener('change', () => {
      const p = PRESETS[+preset.value];
      if (preset.value === '' || !p) return;
      dIn.value = String(p.d); wIn.value = String(p.w); hIn.value = String(p.h);
      render();
    });
    for (const el of [dIn, wIn, hIn]) {
      el.addEventListener('input', () => { syncPreset(); render(); });
    }

    // 从 URL 恢复（?d=27&w=3840&h=2160）
    const q = new URLSearchParams(location.search);
    const qd = +(q.get('d') ?? ''), qw = +(q.get('w') ?? ''), qh = +(q.get('h') ?? '');
    if (qd > 0 && qw > 0 && qh > 0) {
      dIn.value = String(qd); wIn.value = String(qw); hIn.value = String(qh);
    }
    syncPreset();
    render(q.has('d'));
  </script>
</Base>

<style>
  .calc {
    margin: 1.6rem 0 1.2rem;
    padding: 1.1rem 1.2rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--card);
  }
  .calc-row { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-bottom: 0.8rem; }
  .calc-field { display: flex; flex-direction: column; gap: 0.3rem; flex: 1 1 8rem; min-width: 0; }
  .calc-preset { flex-basis: 100%; }
  .calc-field span { font-size: 0.82rem; color: var(--ink-2); font-weight: 600; }
  .calc-field input,
  .calc-field select {
    font: inherit;
    font-size: 1rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
    width: 100%;
  }
  .calc-out {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1.4rem;
    align-items: start;
    margin-bottom: 1rem;
  }
  .calc-stat { display: flex; align-items: baseline; gap: 0.3rem; }
  .calc-num { font-size: 3.2rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .calc-unit { color: var(--ink-3); font-weight: 600; }
  .calc-verdict { border-left: 3px solid var(--rule-strong); padding-left: 0.9rem; }
  .calc-verdict strong { display: block; margin-bottom: 0.3rem; }
  .calc-verdict p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .calc-verdict[data-tone='good'] { border-color: var(--green); }
  .calc-verdict[data-tone='good'] strong { color: var(--k-hands-fg); }
  .calc-verdict[data-tone='ok'] { border-color: var(--accent); }
  .calc-verdict[data-tone='ok'] strong { color: var(--k-comparison-fg); }
  .calc-verdict[data-tone='warn'] { border-color: var(--k-guide-fg); }
  .calc-verdict[data-tone='warn'] strong { color: var(--k-guide-fg); }

  .ladder { grid-column: 1 / -1; margin: 1.2rem 0 0.4rem; }
  .ladder-track { position: relative; height: 12px; border-radius: 6px; overflow: visible; background: var(--code-bg); }
  .ladder-zone { position: absolute; top: 0; bottom: 0; }
  .z-low { background: var(--k-guide-bg); border-radius: 6px 0 0 6px; }
  .z-ok { background: var(--k-comparison-bg); }
  .z-frac { background: var(--k-guide-bg); }
  .z-good { background: var(--k-hands-bg); }
  .z-dense { background: var(--k-comparison-bg); border-radius: 0 6px 6px 0; }
  .ladder-mark {
    position: absolute; top: -5px; width: 4px; height: 22px; margin-left: -2px;
    border-radius: 2px; background: var(--ink); transition: left 0.2s ease;
  }
  .ladder-ticks { position: relative; height: 1.3rem; font-size: 0.72rem; color: var(--ink-3); }
  .ladder-ticks span { position: absolute; top: 0.3rem; transform: translateX(-50%); font-variant-numeric: tabular-nums; }

  .calc-facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.2rem 1.4rem;
    margin: 0.4rem 0 0;
  }
  .calc-facts div { border-top: 1px solid var(--rule); padding: 0.55rem 0; }
  .calc-facts dt { font-size: 0.8rem; color: var(--ink-3); }
  .calc-facts dd { margin: 0.1rem 0 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .calc-share { grid-column: 1 / -1; margin: 0.4rem 0 0; }
  .calc-note { font-size: 0.88rem; color: var(--ink-3); }

  @media (max-width: 520px) {
    .calc-out { grid-template-columns: 1fr; }
    .tick-218 { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ladder-mark { transition: none; }
  }
</style>
