---
// ─────────────────────────────────────────────────────────────
// 硬件线的支柱页（pillar page）。
// 规则和 /tools/ 一样：只写手上真有的设备，写失败，写时间成本。
// ─────────────────────────────────────────────────────────────
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { byNewest } from '../../lib/posts';
import { resolveHero } from '../../lib/hero';

const posts = (await getCollection('setup', ({ data }) => !data.draft)).sort(byNewest);
---
<Base
  title="The Workflow Setup"
  description="The hardware behind the workflow: monitors, keyboards, docks and drives. Long-term notes on devices I own, and researched buying guides labelled as such."
  noindex={posts.length === 0}
>
  <h1>The Workflow Setup</h1>
  <p class="lede">
    The other half of the site. The tools line covers software I test; this line
    covers the <strong>hardware</strong> — what it was bought for, how long it has
    been on the desk, where it broke, and what it really cost including the hours.
    Where a post rests on specifications instead of a device I own, the first line
    of that post says so.
  </p>

  <h2>How this line is written</h2>
  <p>
    Same standard as the tools line. There are two kinds of post here, and each one
    is labelled at the top:
  </p>
  <ul>
    <li><strong>Owned.</strong> A device I bought and use, written up after months rather than after unboxing. Nothing here is borrowed, seeded, or bought for the sake of a post.</li>
    <li><strong>Researched.</strong> A buying guide built from manufacturer spec pages, published prices and other people's testing. Marked <em>Researched</em>, never written in the first person, and never claiming an experience I didn't have. I can recommend something I haven't held; I can't write as if I'd used it.</li>
    <li><strong>Long enough to know.</strong> For anything owned, the write-up comes after months of use. Early enthusiasm and month-three opinion are usually different, and the post tells you which one it is.</li>
    <li><strong>Manuals and official specs only.</strong> Numbers come from the manufacturer's own page, not from third-party roundup sites.</li>
    <li><strong>Costs stated.</strong> Price paid, anything it forced me to buy, and the hours it cost in setup, debugging and returns.</li>
    <li><strong>Failures included.</strong> Where it broke, or where I gave up on a feature, gets written up too.</li>
  </ul>
  <p class="meta">
    The full methodology and conflict-of-interest statement are on the
    <a href="/about/">About</a> page, and the affiliate policy is on the
    <a href="/affiliate-disclosure/">disclosure page</a>.
  </p>

  <h2>Tools</h2>
  <p>
    <a href="/setup/mac-monitor-ppi-calculator/"><strong>Mac monitor ppi and scaling calculator</strong></a> —
    enter a monitor's size and resolution to see whether macOS will render it at a clean
    Retina 2×, native 1×, or in the fractional zone where text goes soft.
  </p>

  <h2 class="section-head k-hardware">
    <span class="line">Devices</span>
    <span class="count">{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span>
  </h2>
  {posts.length === 0 ? (
    <p class="meta">
      Nothing published yet. The first write-ups are in progress.
    </p>
  ) : (
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard
          href={`/setup/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          kind={post.data.kind}
          pubDate={post.data.pubDate}
          image={resolveHero(post.data.hero)?.src}
          showKind={false}
        />
      ))}
    </div>
  )}
</Base>
