---
// ─────────────────────────────────────────────────────────────
// 支柱页（pillar page）。
// 作用：① 承接 cluster 的主关键词 ② 向下分发权重到每篇文章
// ─────────────────────────────────────────────────────────────
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const GROUPS = [
  {
    kind: 'comparison',
    label: 'Comparisons',
    blurb: 'Same real task, several tools, side by side — and where they diverge.',
  },
  {
    kind: 'hands-on',
    label: 'Hands-on',
    blurb: 'One project taken from nothing to working, including what broke.',
  },
  {
    kind: 'guide',
    label: 'Guides',
    blurb: 'The shortest path from install to actually using it.',
  },
] as const;

const byKind = (k: string) => posts.filter((p) => p.data.kind === k);
---
<Base
  title="AI Tools, Tested"
  description="Hands-on tests of AI coding and agent tools: head-to-head comparisons, real-project write-ups, and setup guides. Every conclusion comes from actual work, not feature lists."
>
  <h1>AI Tools, Tested</h1>
  <p class="lede">
    This is the main line of the site. Every post is built around a <strong>real work task</strong> — I take a tool at a job I already had to do, then record what it managed, where it stalled, and whether it was worth paying for.
  </p>

  <h2>How I test</h2>
  <p>
    So that posts can be compared against each other, every test follows the same rules:
  </p>
  <ul>
    <li><strong>Same task.</strong> In a head-to-head, every tool gets the identical task. I don't swap the problem halfway.</li>
    <li><strong>Real projects.</strong> Tasks come from work I actually had to do, never a demo built for the post.</li>
    <li><strong>Failures included.</strong> Where a tool fell over gets written up too. A review with only wins carries no information.</li>
    <li><strong>Costs stated.</strong> Subscription price, token spend, and the hours it cost me.</li>
    <li><strong>Dated.</strong> These tools change every few weeks, so every post carries a test date and version numbers.</li>
  </ul>
  <p class="meta">
    The full methodology and conflict-of-interest statement are on the <a href="/about/">About</a> page.
  </p>

  {GROUPS.map((g) => {
    const list = byKind(g.kind);
    return (
      <section>
        <h2>{g.label}</h2>
        <p>{g.blurb}</p>
        {list.length === 0 ? (
          <p class="meta">Nothing in this group yet.</p>
        ) : (
          <ul class="post-list">
            {list.map((post) => (
              <li>
                <a class="title" href={`/tools/${post.id}/`}>{post.data.title}</a>
                <p>{post.data.description}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</Base>
