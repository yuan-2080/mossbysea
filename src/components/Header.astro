---
import { SITE, NAV } from '../consts';
---
<header class="site-head">
  <a class="brand" href="/">
    <svg class="brand-mark" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
      <rect class="mark-bg" width="512" height="512" rx="112" />
      <rect x="80" y="300" width="352" height="56" rx="8" fill="#2a78d6" />
      <rect x="146" y="172" width="128" height="128" rx="14" fill="#1baf7a" />
    </svg>
    <span>{SITE.name}</span>
  </a>
  <nav>
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>
