---
import { SITE, FOOTER_NAV } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <nav>
    {FOOTER_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <p>
    © {year} {SITE.author} · {SITE.name} — this site contains affiliate links.
    See the <a href="/affiliate-disclosure/">disclosure</a>.
  </p>
</footer>
