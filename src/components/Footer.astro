---
import { SITE, FOOTER_NAV } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <nav>
    {FOOTER_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <p>
    © {year} {SITE.author} · {SITE.name} — how this site is funded, and what
    that does to what you read: <a href="/affiliate-disclosure/">affiliate disclosure</a>.
  </p>
  <p>
    As an Amazon Associate I earn from qualifying purchases. Links to other
    merchants may also earn a commission.
  </p>
</footer>
